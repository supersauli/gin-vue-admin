	post /admin/pool/update (UpdatePoolRequest) returns (UpdatePoolResponse)

	@doc "查询卡池"
	@handler QueryPool
	get /admin/pools (QueryPoolRequest) returns (QueryPoolResponse)

	@doc "删除卡池"
	@handler DeletePool
	post /admin/pool/delete (DeletePoolRequest) returns (CommonResponse)

	// ==================== 管理员-概率配置 ====================
	@doc "创建概率配置"
	@handler CreateProb
	post /admin/pool/prob/create (CreateProbRequest) returns (CreateProbResponse)

	@doc "更新概率配置"
	@handler UpdateProb
	post /admin/pool/prob/update (UpdateProbRequest) returns (UpdateProbResponse)

	@doc "查询概率配置"
	@handler QueryProb
	get /admin/pool/probs (QueryProbRequest) returns (QueryProbResponse)

	@doc "删除概率配置"
	@handler DeleteProb
	post /admin/pool/prob/delete (DeleteProbRequest) returns (CommonResponse)

	// ==================== 管理员-抽卡规则 ====================
	@doc "创建抽卡规则"
	@handler CreateRule
	post /admin/gacha/rule/create (CreateRuleRequest) returns (CreateRuleResponse)

	@doc "更新抽卡规则"
	@handler UpdateRule
	post /admin/gacha/rule/update (UpdateRuleRequest) returns (UpdateRuleResponse)

	@doc "查询抽卡规则"
	@handler QueryRule
	get /admin/gacha/rules (QueryRuleRequest) returns (QueryRuleResponse)

	@doc "删除抽卡规则"
	@handler DeleteRule
	post /admin/gacha/rule/delete (DeleteRuleRequest) returns (CommonResponse)

	// ==================== 管理员-抽卡日志查询 ====================
	@doc "查询抽卡日志(支持按用户、卡池、时间筛选)"
	@handler QueryGachaLog
	get /admin/gacha/logs (QueryGachaLogRequest) returns (QueryGachaLogResponse)

	// ==================== 管理员-道具管理 ====================
	@doc "创建道具数据"
	@handler CreateItem
	post /admin/item/create (CreateItemRequest) returns (CreateItemResponse)

	@doc "更新道具数据"
	@handler UpdateItem
	post /admin/item/update (UpdateItemRequest) returns (UpdateItemResponse)

	@doc "查询道具"
	@handler QueryItem
	get /admin/items (QueryItemRequest) returns (QueryItemResponse)

	@doc "删除道具数据"
	@handler DeleteItem
	post /admin/item/delete (DeleteItemRequest) returns (CommonResponse)

	// ==================== 管理员-NPC管理 ====================
	@doc "创建NPC数据"
	@handler CreateNPC
	post /admin/npc/create (CreateNPCRequest) returns (CreateNPCResponse)

	@doc "更新NPC数据"
	@handler UpdateNPC
	post /admin/npc/update (UpdateNPCRequest) returns (UpdateNPCResponse)

	@doc "查询NPC"
	@handler QueryNPC
	get /admin/npcs (QueryNPCRequest) returns (QueryNPCResponse)

	@doc "删除NPC数据"
